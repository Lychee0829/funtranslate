msgstr "否"

msgid "Name"
msgstr "名字"

msgid "Net Change"
msgstr "净变化"

msgid "Net Upgrade Size:"
msgstr "实际变化："

msgid "New Version"
msgstr "新版本"

msgid "New optional dependencies for %s\n"
msgstr "%s 的新可选依赖\n"

msgid "No"
msgstr "否"

msgid "No database errors have been found!\n"
msgstr "数据库正常！\n"

msgid "No package owns %s\n"
msgstr "没有软件包拥有 %s\n"

msgid "None"
msgstr "无"

msgid "Old Version"
msgstr "旧版本"

msgid "Optional Deps"
msgstr "可选依赖"

