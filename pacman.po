msgid ""
"\n"
"use '%s {-h --help}' with an operation for available options\n"
msgstr ""
"\n"
"使用 '%s {-h --help}' 及某个操作以查看可用选项\n"

msgid ""
"                       This program may be freely redistributed under\n"
"                       the terms of the GNU General Public License.\n"
msgstr ""
"                       本程序可以在GNU一般公众许可条款下\n"
"                       自由分发\n"
"                       本程序不是猫娘，不要调戏\n"

msgid "        pacman-conf (--repo-list|--help|--version)\n"
msgstr "        pacman-conf (--repo-list|--help|--version)\n"

msgid "      --arch <arch>    set an alternate architecture\n"
msgstr "      --arch <架构>    指定另外的架构\n"

msgid "      --asdeps         install packages as non-explicitly installed\n"
msgstr "      --asdeps         作为非单独指定安装的软件包安装\n"

msgid "      --asdeps         mark packages as non-explicitly installed\n"
msgstr "      --asdeps         标记为非明确指定安装的软件包\n"

msgid "      --asexplicit     install packages as explicitly installed\n"
msgstr "      --asexplicit     作为单独指定安装的软件包安装\n"

msgid "      --asexplicit     mark packages as explicitly installed\n"
msgstr "      --asexplicit     标记为明确指定安装的软件包\n"

msgid ""
"      --assume-installed <package=version>\n"
"                       add a virtual package to satisfy dependencies\n"
msgstr ""
"      --assume-installed <软件包=版本>\n"
"                       添加一个虚拟软件包用以满足依赖要求\n"

msgid "      --cachedir <dir> set an alternate package cache location\n"
msgstr "      --cachedir <目录> 指定另外的软件包缓存位置\n"

msgid "      --color <when>   colorize the output\n"
msgstr "      --color <when>  彩色化输出\n"

msgid "      --config <path>  set an alternate configuration file\n"
msgstr "      --config <路径>  指定另外的配置文件\n"

msgid "      --confirm        always ask for confirmation\n"
msgstr "      --confirm        总是询问确认\n"

msgid ""
"      --dbonly         only modify database entries, not package files\n"
msgstr "      --dbonly         仅修改数据库条目，而非软件包文件\n"

msgid "      --debug          display debug messages\n"
msgstr "      --debug          显示调试信息\n"

msgid ""
"      --disable-download-timeout\n"
"                       use relaxed timeouts for download\n"
msgstr ""
"      --disable-download-timeout\n"
"                       下载时用宽松的超时\n"

msgid ""
"      --disable-sandbox\n"
"                       disables all sandbox features used for the downloader "
"process\n"
msgstr ""
"      --disable-sandbox\n"
"                       禁用用于下载进程的所有沙盒功能\n"

msgid ""
"      --disable-sandbox-filesystem\n"
"                       disables the filesystem part of the downloader "
"process sandbox\n"
msgstr ""
"      --disable-sandbox-filesystem\n"
"                       禁用下载进程沙盒的文件系统部分\n"

msgid ""
"      --disable-sandbox-syscalls\n"
"                       disables the syscalls part of the downloader process "
"sandbox\n"
msgstr ""
"      --disable-sandbox-syscalls\n"
"                       禁用下载进程沙盒的系统调用部分\n"

msgid "      --gpgdir <path>  set an alternate home directory for GnuPG\n"
msgstr "      --gpgdir <路径>  指定 GnuPG 的另外的主目录\n"

msgid "      --hookdir <dir>  set an alternate hook location\n"
msgstr "      --hookdir <目录>  指定另外的钩子位置\n"

msgid ""
"      --ignore <pkg>   ignore a package upgrade (can be used more than "
"once)\n"
msgstr "      --ignore <软件包>    升级时忽略某个软件包 (可多次使用) \n"

msgid ""
"      --ignoregroup <grp>\n"
"                       ignore a group upgrade (can be used more than once)\n"
msgstr ""
"      --ignoregroup <软件包组>\n"
"                         升级时忽略某个软件包组 (可多次使用) \n"

msgid "      --logfile <path> set an alternate log file\n"
msgstr "      --logfile <路径> 指定另外的日志文件\n"

msgid ""
"      --machinereadable\n"
"                       produce machine-readable output\n"
msgstr ""
"      --machinereadable\n"
"                       产生机器可读输出\n"

msgid "      --needed         do not reinstall up to date packages\n"
msgstr "      --needed         不重新安装已是最新的软件包\n"

msgid "      --noconfirm      do not ask for any confirmation\n"
msgstr "      --noconfirm      不询问确认\n"

msgid ""
"      --noprogressbar  do not show a progress bar when downloading files\n"
msgstr "      --noprogressbar  下载文件时不显示进度条\n"

msgid ""
"      --noscriptlet    do not execute the install scriptlet if one exists\n"
msgstr "      --noscriptlet    不执行安装小脚本\n"

msgid ""
"      --overwrite <glob>\n"
"                       overwrite conflicting files (can be used more than "
"once)\n"
msgstr ""
" --overwrite  <glob>\n"
"                        覆盖冲突的文件（可以指定多次）\n"

msgid ""
"      --print-format <string>\n"
"                       specify how the targets should be printed\n"
msgstr ""
"      --print-format <字符串>\n"
"                       指定如何打印目标\n"

msgid "      --sysroot        operate on a mounted guest system (root-only)\n"
msgstr "      --sysroot        在一个已挂载的 guest 系统操作（仅 root）\n"

msgid "  -R, --rootdir=<path> set an alternate installation root\n"
msgstr "  -R, --rootdir=<path> 指定另外的安装根目录\n"

msgid "  -S, --sysroot=<path> set an alternate system root\n"
msgstr "  -S, --sysroot=<path> 指定另外的系统根目录\n"

msgid "  -V, --version        display version information\n"
msgstr " -V, --version display       显示版本信息\n"

msgid "  -b, --dbpath <path>  set an alternate database location\n"
msgstr "  -b, --dbpath <路径>  指定另外的数据库位置\n"

msgid ""
"  -c, --cascade        remove packages and all packages that depend on them\n"
msgstr "  -c, --cascade        删除软件包及所有依赖于此的软件包\n"

msgid "  -c, --changelog      view the changelog of a package\n"
msgstr "  -c, --changelog      查看某软件包的更新日志\n"

msgid ""
"  -c, --clean          remove old packages from cache directory (-cc for "
"all)\n"
msgstr "  -c, --clean          从缓存目录中删除旧软件包 (-cc 清除所有) \n"

msgid "  -c, --config=<path>  set an alternate configuration file\n"
msgstr "  -c, --config=<path>  指定另外的配置文件\n"

msgid ""
"  -d, --deps           list packages installed as dependencies [filter]\n"
msgstr "  -d, --deps           列出所有作为依赖关系安装的软件包 [过滤器]\n"

msgid ""
"  -d, --nodeps         skip dependency version checks (-dd to skip all "
"checks)\n"
msgstr "  -d, --nodeps         跳过依赖关系的版本检查 (-dd 跳过所有检查)\n"

msgid "  -e, --explicit       list packages explicitly installed [filter]\n"
msgstr "  -e, --explicit       列出所有单独指定安装的软件包 [过滤器]\n"

msgid "  -g, --groups         view all members of a package group\n"
msgstr "  -g, --groups         查看某软件包组所属的所有软件包\n"

msgid ""
"  -g, --groups         view all members of a package group\n"
"                       (-gg to view all groups and members)\n"
msgstr ""
"  -g, --groups         查看某软件包组所属的所有软件包\n"
"                       (-gg 查看所有软件包组和所属于它们的软件包)\n"

msgid "  -h, --help           display this help information\n"
msgstr "  -h, --help           显示此帮助信息\n"

msgid ""
"  -i, --info           view package information (-ii for backup files)\n"
msgstr "  -i, --info           查看软件包信息 (-ii 查看备份文件) \n"

msgid ""
"  -i, --info           view package information (-ii for extended "
"information)\n"
msgstr "  -i, --info           查看软件包信息 (-ii 查看更多信息)\n"

msgid ""
"  -k, --check          check that package files exist (-kk for file "
"properties)\n"
msgstr "  -k, --check          检查软件包的文件存在(-kk检查文件属性)\n"

msgid ""
"  -k, --check          test local database for validity (-kk for sync "
"databases)\n"
msgstr "  -k, --check          检查本地数据库有效性 (-kk 以同步数据库)\n"

msgid "  -l, --list           list the files owned by the queried package\n"
msgstr "  -l, --list           列出被查询软件包的文件列表\n"

msgid "  -l, --list <repo>    view a list of packages in a repo\n"
msgstr "  -l, --list <repo>    查看在该软件库中的软件包清单\n"

msgid "  -l, --repo-list      list configured repositories\n"
msgstr "  -l, --repo-list      列出配置的仓库\n"

msgid ""
"  -m, --foreign        list installed packages not found in sync db(s) "
"[filter]\n"
msgstr "  -m, --foreign        列出不在同步数据库中的已安装软件包 [过滤器]\n"

msgid ""
"  -n, --native         list installed packages only found in sync db(s) "
"[filter]\n"
msgstr "  -n, --native         列出只在同步数据库中的已安装软件包 [过滤]\n"

msgid "  -n, --nosave         remove configuration files\n"
msgstr "  -n, --nosave         删除配置文件\n"

msgid "  -o, --owns <file>    query the package that owns <file>\n"
msgstr "  -o, --owns <file>    查询哪个软件包拥有 <file>\n"

msgid "  -p, --file <package> query a package file instead of the database\n"
msgstr "  -p, --file <package>  从某个软件包而不是数据库查询\n"

msgid ""
"  -p, --print          print the targets instead of performing the "
"operation\n"
msgstr "  -p, --print          打印目标而不是执行操作\n"

msgid "  -q, --quiet          show less information for query and search\n"
msgstr "  -q, --quiet          在查询或搜索时显示较少的信息\n"

msgid "  -q, --quiet          suppress output of success messages\n"
msgstr "  -q, --quiet          不显示成功消息的输出\n"

msgid "  -r, --repo=<remote>  query options for a specific repo\n"
msgstr "  -r, --repo=<remote>  在某个特定的仓库中查询\n"

msgid "  -r, --root <path>    set an alternate installation root\n"
msgstr "  -r, --root <路径>    指定另外的安装根目录\n"

msgid ""
"  -s, --recursive      remove unnecessary dependencies\n"
"                       (-ss includes explicitly installed dependencies)\n"
msgstr ""
"  -s, --recursive      删除不需要的依赖关系\n"
"                       (-ss 包括单独指定安装的依赖关系)\n"

msgid ""
"  -s, --search <regex> search locally-installed packages for matching "
"strings\n"
msgstr "  -s, --search <regex> 搜寻符合指定字符串的已安装本地的软件包\n"

msgid ""
"  -s, --search <regex> search remote repositories for matching strings\n"
msgstr "  -s, --search <regex> 按照指定字符串查询远端软件库\n"

msgid ""
"  -t, --unrequired     list packages not (optionally) required by any\n"
"                       package (-tt to ignore optdepends) [filter]\n"
msgstr ""
"  -t, --unrequired     列出不被任何软件包(可选)要求的软件包(-tt 忽略可选依"
"赖) [过滤器]\n"

msgid ""
"  -u, --sysupgrade     upgrade installed packages (-uu enables downgrades)\n"
msgstr "  -u, --sysupgrade     升级所有已安装的软件包 (-uu 允许降级)\n"

msgid "  -u, --unneeded       remove unneeded packages\n"
msgstr "  -u, --unneeded       删除不需要的软件包\n"

msgid "  -u, --upgrades       list outdated packages [filter]\n"
msgstr "  -u, --upgrades       列出所有可升级的软件包 [过滤器]\n"

msgid "  -v, --verbose        always show directive names\n"
msgstr "  -v, --verbose        总是显示指示符名称\n"

msgid "  -v, --verbose        be verbose\n"
msgstr "  -v, --verbose        显示详细信息\n"

msgid ""
"  -w, --downloadonly   download packages but do not install/upgrade "
"anything\n"
msgstr "  -w, --downloadonly   下载但不安装/升级软件包\n"

msgid "  -x, --regex          enable searching using regular expressions\n"
msgstr "  -x, --regex          启用正则表达式进行搜索\n"

msgid ""
"  -y, --refresh        download fresh package databases from the server\n"
"                       (-yy to force a refresh even if up to date)\n"
msgstr ""
"  -y, --refresh        从服务器下载新的软件包数据库\n"
"                       (-yy 强制更新软件包数据库)\n"

msgid "  All current sync database packages\n"
msgstr "  所有目前同步数据库的软件包\n"

msgid "  All locally installed packages\n"
msgstr "  所有本地安装的软件包\n"

msgid ""
"  if you're sure a package manager is not already\n"
"  running, you can remove %s\n"
msgstr ""
"  如果你确认软件包管理器没有在运行，\n"
"  你可以删除 %s。\n"

msgid " %s downloading...\n"
msgstr "%s正在下载……\n"

msgid " %s failed to download"
msgstr "%s下载失败"

msgid " %s is up to date"
msgstr " %s 新鲜美味😋"

msgid " [installed]"
msgstr " [已安装]"

msgid " [pending]"
msgstr " [等待中]"

msgid " there is nothing to do\n"
msgstr " 没什么可做的喵(＾－＾)V\n"

msgid "%jd altered file\n"
msgid_plural "%jd altered files\n"
msgstr[0] "%jd 变化的文件\n"

msgid "%jd missing file\n"
msgid_plural "%jd missing files\n"
msgstr[0] "%jd 缺失文件\n"

msgid "%s exists in both '%s' and '%s'\n"
msgstr "%s 同时存在于 '%s' 和 '%s'\n"

msgid "%s installed as %s.pacnew\n"
msgstr "%s 已被安装为 %s.pacnew\n"

msgid "%s is designated as a HoldPkg.\n"
msgstr "%s 被指定为 HoldPkg (保留软件包) 。\n"

msgid "%s is in IgnorePkg/IgnoreGroup. Install anyway?"
msgstr "%s 在忽略软件包／忽略软件包组中。确定要安装吗?"

msgid "%s is invalid or corrupted\n"
msgstr "%s 无效或已损坏\n"

msgid "%s is owned by %s%s %s%s%s\n"
msgstr "%s 由 %s%s %s%s%s 所拥有\n"

msgid "%s is owned by %s%s/%s%s %s%s%s\n"
msgstr "%s 由 %s%s/%s%s %s%s%s 所拥有\n"

msgid "%s optionally requires %s\n"
msgstr "%s可选依赖于%s\n"

msgid "%s saved as %s.pacsave\n"
msgstr "%s 已被保存为 %s.pacsave\n"

msgid "%s, %s from \"%s\""
msgstr "%s，%s 来自 \"%s\""

msgid "%s-%s and %s-%s are in conflict\n"
msgstr "%s-%s 与 %s-%s 有冲突\n"

msgid "%s-%s and %s-%s are in conflict (%s)\n"
msgstr "%s-%s 与 %s-%s 有冲突 (%s)\n"

msgid "%s-%s%s%s and %s-%s%s%s are in conflict (%s). Remove %s?"
msgstr "%s-%s%s%s 与 %s-%s%s%s 有冲突 (%s)。删除 %s 吗？"

msgid "%s-%s%s%s and %s-%s%s%s are in conflict. Remove %s?"
msgstr "%s-%s%s%s 与 %s-%s%s%s 有冲突。删除 %s 吗？"

msgid "%s: %jd total file, "
msgid_plural "%s: %jd total files, "
msgstr[0] "%s: %jd 全部文件，"

msgid "%s: %s (%s checksum information not available)\n"
msgstr "%s：%s（%s的校验和信息不存在）\n"

msgid "%s: %s (%s checksum mismatch)\n"
msgstr "%s：%s（%s校验和不一致）\n"

msgid "%s: %s (File type mismatch)\n"
msgstr "%s: %s (文件类型不匹配)\n"

msgid "%s: %s (GID mismatch)\n"
msgstr "%s: %s (用户组标识符GID不匹配)\n"

msgid "%s: %s (Modification time mismatch)\n"
msgstr "%s: %s (修改时间不匹配)\n"

msgid "%s: %s (Permissions mismatch)\n"
msgstr "%s: %s (权限不匹配)\n"

msgid "%s: %s (Size mismatch)\n"
msgstr "%s: %s (大小不匹配)\n"

msgid "%s: %s (Symlink path mismatch)\n"
msgstr "%s: %s (符号链接路径不匹配)\n"

msgid "%s: %s (UID mismatch)\n"
msgstr "%s: %s (用户标识符UID不匹配)\n"

msgid "%s: %s (failed to calculate %s checksum)\n"
msgstr "%s：%s（计算 %s 的校验和失败）\n"

msgid "%s: %s exists in filesystem\n"
msgstr "%s: 文件系统中已存在 %s \n"

msgid "%s: %s exists in filesystem (owned by %s)\n"
msgstr "%s: 文件系统中存在 %s （由 %s 所有）\n"

msgid "%s: install reason has been set to 'explicitly installed'\n"
msgstr "%s：安装原因设定为“单独指定安装”\n"

msgid "%s: install reason has been set to 'installed as dependency'\n"
msgstr "%s：安装原因设定为“作为依赖关系安装”\n"

msgid "%s: no mtree file\n"
msgstr "%s: 没有 mtree 文件\n"

msgid "'%s' is a file, did you mean %s instead of %s?\n"
msgstr "'%s' 是一个文件，您是否想要 %s 而不是 %s?\n"

msgid "'%s' is a file, you might want to use %s.\n"
msgstr "'%s' 是一个文件，您可能打算使用 %s。\n"

msgid "'%s' is not a valid debug level\n"
msgstr "'%s' 不是有效的调试级别\n"

