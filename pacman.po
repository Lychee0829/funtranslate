msgstr "架构"

msgid "Backup Files"
msgstr "备份文件"

msgid "Build Date"
msgstr "编译日期"

msgid "Cache directory: %s\n"
msgstr "缓存目录：%s\n"

msgid "Cannot find the given file.\n"
msgstr "找不到指定的文件。\n"

msgid "Cannot open the given file.\n"
msgstr "无法打开指定的文件。\n"

msgid "Changelog for %s:\n"
msgstr "%s的更新日志：\n"

msgid "Compressed Size"
msgstr "压缩后大小"

msgid "Conflicts With"
msgstr "与它冲突"

msgid "Database directory: %s\n"
msgstr "数据库目录：%s\n"

msgid "Depends On"
msgstr "依赖于"

msgid "Description"
msgstr "描述"

msgid "Do you want to remove ALL files from cache?"
msgstr "打算从缓存中删除所有文件吗？"

msgid "Do you want to remove all other packages from cache?"
msgstr "您想从缓存中删除所有其他的软件包吗？"

msgid "Do you want to remove these packages?"
msgstr "打算处死这些软件包吗✧(≖ ◡ ≖✿)？"

msgid "Do you want to remove unused repositories?"
msgstr "打算删除无用的软件库？"

msgid "Do you want to skip the above package for this upgrade?"
msgid_plural "Do you want to skip the above packages for this upgrade?"
msgstr[0] "您想在本次更新中跳过上述软件包吗？"

msgid "Download Size"
msgstr "下载大小"

msgid "Enter a number (default=%d)"
msgstr "输入某个数字 ( 默认=%d )"

msgid "Enter a selection (default=all)"
msgstr "输入某个选择 ( 默认=全部选定 )"

msgid "Errors occurred, no packages were upgraded.\n"
msgstr "发生错误，没有软件包被更新。\n"

msgid "Expired"
msgstr "已过期"

msgid "Explicitly installed"
msgstr "单独指定安装"

msgid "Failed to pass %s entry to libalpm"
msgstr "传递 %s 条目至 libalpm 失败"

msgid ""
"File %s is corrupted (%s).\n"
"Do you want to delete it?"
msgstr ""
"文件 %s 已损坏 (%s).\n"
"打算删除吗？"

msgid "Groups"
msgstr "组"

msgid "HTTP_USER_AGENT truncated\n"
msgstr "HTTP_USER_AGENT 被截断\n"

msgid "HoldPkg was found in target list. Do you want to continue?"
msgstr "在目标清单中发现 HoldPkg 指定的软件包。你确定要继续吗？"

msgid "Import PGP key %s, \"%s\"?"
msgstr "是否导入 PGP 公钥 %s ，\"%s\"？"

msgid "Import PGP key %s?"
msgstr "是否导入 PGP 公钥 %s ？"

msgid "Install Date"
msgstr "安装日期"

msgid "Install Reason"
msgstr "安装原因"

msgid "Install Script"
msgstr "安装脚本"

msgid "Installed Size"
msgstr "安装后大小"

msgid "Installed as a dependency for another package"
msgstr "作为其他软件包的依赖关系安装"

